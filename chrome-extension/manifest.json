{
  "manifest_version": 3,
  "name": "BISWasend Pro",
  "version": "1.1.0",
  "description": "Import Excel vers WASENDPRO et pièces jointes automatiques sur WhatsApp Web.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://wasendpro.vercel.app/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "action": {
    "default_title": "Importer Excel vers WASENDPRO",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "48": "icons/icon48.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://wasendpro.vercel.app/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["whatsapp-content.js"],
      "run_at": "document_idle"
    }
  ]
}
